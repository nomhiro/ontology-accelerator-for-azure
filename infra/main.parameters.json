{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deploymentTier": {
      "value": "${DEPLOYMENT_TIER=minimal}"
    },
    "graphPersistence": {
      "value": "${GRAPH_PERSISTENCE=ephemeral}"
    },
    "modelLocation": {
      "value": "${MODEL_LOCATION}"
    },
    "authMode": {
      "value": "${AUTH_MODE=entra}"
    },
    "webLocation": {
      "value": "${WEB_LOCATION=eastasia}"
    },
    "postgresAdminLogin": {
      "value": "${POSTGRES_ADMIN_LOGIN=ontologyadmin}"
    },
    "postgresAdminPassword": {
      "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} postgres-admin-password)"
    },
    "fusekiAdminPassword": {
      "value": "$(secretOrRandomPassword ${AZURE_KEY_VAULT_NAME} fuseki-admin-password)"
    },
    "fusekiCpu": {
      "value": "${FUSEKI_CPU=0.5}"
    },
    "fusekiMemory": {
      "value": "${FUSEKI_MEMORY=1Gi}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "entraApiAudience": {
      "value": "${ENTRA_API_AUDIENCE}"
    },
    "logLevel": {
      "value": "${LOG_LEVEL=INFO}"
    },
    "apiImageName": {
      "value": "${SERVICE_API_IMAGE_NAME}"
    },
    "mcpImageName": {
      "value": "${SERVICE_MCP_IMAGE_NAME}"
    },
    "fusekiImageName": {
      "value": "${SERVICE_FUSEKI_IMAGE_NAME}"
    }
  }
}
